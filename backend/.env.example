# SignBridge ASR Configuration
PROJECT_NAME="SignBridge Speech Recognition API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Server Host and Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="*"

# Faster Whisper Model Configuration
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
PRELOAD_MODEL_ON_STARTUP=false
